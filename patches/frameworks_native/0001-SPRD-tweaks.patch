From d838d014aefd5e278848a29fb81afd8172801e4d Mon Sep 17 00:00:00 2001
From: Joseph Emmanuel Dayo <joseph.dayo@gmail.com>
Date: Wed, 28 Jun 2017 06:31:41 +0800
Subject: [PATCH] SPRD tweaks (ported to lineage-15.1 / Android 8.1)

Ported from the lineage-14.1 (Android 7.1, dual HWC1/HWC2 SurfaceFlinger)
version of this patch to lineage-15.1 (Android 8.1, unified HWC2-only
SurfaceFlinger). See the NOTE blocks below for what changed and why -
some hunks from the original patch are dropped because AOSP itself
already carries the fix upstream in 8.1, and some files this patch
touched no longer exist.

Change-Id: I11e4d9f4e27419004b4310ce8a3df4f81068fefe
---
 include/ui/DisplayInfo.h                   |  1 +
 libs/binder/IServiceManager.cpp            |  5 ++
 services/surfaceflinger/Android.mk         |  9 +++
 services/surfaceflinger/DisplayDevice.cpp  |  9 +++
 services/surfaceflinger/SurfaceFlinger.cpp | 63 +++++++++++++++++++--
 services/surfaceflinger/SurfaceFlinger.h   |  2 +
 6 files changed, 85 insertions(+), 4 deletions(-)

diff --git a/include/ui/DisplayInfo.h b/include/ui/DisplayInfo.h
index 799944f3e..ad73ee72f 100644
--- a/include/ui/DisplayInfo.h
+++ b/include/ui/DisplayInfo.h
@@ -36,6 +36,7 @@ struct DisplayInfo {
     bool secure;
     nsecs_t appVsyncOffset;
     nsecs_t presentationDeadline;
+    int colorTransform;
 };

 /* Display orientations as defined in Surface.java and ISurfaceComposer.h. */
--
# NOTE: DisplayInfo.h is unchanged between 14.1 and 15.1 (confirmed against
# android-8.1.0_r9 usage of info.secure/info.appVsyncOffset/
# info.presentationDeadline in SurfaceFlinger::getDisplayConfigs). This hunk
# applies as-is.

diff --git a/libs/binder/IServiceManager.cpp b/libs/binder/IServiceManager.cpp
index 44d235f0f..6429eb921 100644
--- a/libs/binder/IServiceManager.cpp
+++ b/libs/binder/IServiceManager.cpp
@@ -139,6 +139,11 @@ public:
     virtual sp<IBinder> getService(const String16& name) const
     {
         unsigned n;
+        if (strcmp(String8(name).string(), "atchannel") == 0) {
+          sleep(1000);
+          return NULL;
+        }
+
         for (n = 0; n < 5; n++){
             if (n > 0) {
                 ALOGI("Waiting for service %s...", String8(name).string());
--
# NOTE: this is a device-specific hack unrelated to the HWC1/HWC2 refactor,
# so it should still apply near-verbatim. Verify line numbers against your
# actual libbinder revision - libbinder was also being split toward
# libhwbinder/AIDL-adjacent work around this era, so context lines may have
# shifted even though the function body has not.

diff --git a/services/surfaceflinger/Android.mk b/services/surfaceflinger/Android.mk
index 18cc946be..298527625 100644
--- a/services/surfaceflinger/Android.mk
+++ b/services/surfaceflinger/Android.mk
@@ -42,7 +42,8 @@ LOCAL_SRC_FILES := \

 LOCAL_C_INCLUDES := \
 	frameworks/native/vulkan/include \
-	external/vulkan-validation-layers/libs/vkjson
+	external/vulkan-validation-layers/libs/vkjson \
+	$(TOP)/hardware/sprd/hwcomposer

 LOCAL_CFLAGS := -DLOG_TAG=\"SurfaceFlinger\"

@@ -138,6 +139,15 @@ ifeq ($(BOARD_USE_BGRA_8888),true)
     LOCAL_CFLAGS += -DUSE_BGRA_8888
 endif

+#SPRD FLAGS START
+ifeq ($(SPRD_ENABLE_FRAMEBUFFER_AFBC),1)
+    LOCAL_CFLAGS += -DSPRD_ENABLE_FRAMEBUFFER_AFBC=$(SPRD_ENABLE_FRAMEBUFFER_AFBC)
+endif
+ifeq ($(strip $(TARGET_GPU_PLATFORM)),midgard)
+    LOCAL_CFLAGS += -DGPU_IS_MIDGARD
+endif
+#SPRD FLAGS END
+
 LOCAL_CFLAGS += -fvisibility=hidden -Werror=format
 LOCAL_CFLAGS += -std=c++14

--
# NOTE: the VSYNC_EVENT_PHASE_OFFSET_NS / SF_VSYNC_EVENT_PHASE_OFFSET_NS
# LOCAL_CFLAGS hunk from the original patch is DROPPED. Those defines were
# removed from Android.mk in Oreo - phase offsets now come from the
# ISurfaceFlingerConfigs HIDL config (confirmed live in
# SurfaceFlinger::SurfaceFlinger() in 8.1.0_r9:
#   vsyncPhaseOffsetNs = getInt64<ISurfaceFlingerConfigs,
#       &ISurfaceFlingerConfigs::vsyncEventPhaseOffsetNs>(1000000);
# Setting it via configstore (device/<vendor>/<device>/configstore, or the
# ISurfaceFlingerConfigs.xml override) is the 15.1-correct way to override
# the vsync offset, not an Android.mk -D flag.

diff --git a/services/surfaceflinger/DisplayDevice.cpp b/services/surfaceflinger/DisplayDevice.cpp
index a3b0cfee5..733c1b3f5 100644
--- a/services/surfaceflinger/DisplayDevice.cpp
+++ b/services/surfaceflinger/DisplayDevice.cpp
@@ -47,6 +47,8 @@
 #include "SurfaceFlinger.h"
 #include "Layer.h"

+#include "SprdConfigChoose.h"
+
 // ----------------------------------------------------------------------------
 using namespace android;
 // ----------------------------------------------------------------------------
@@ -121,7 +123,14 @@ DisplayDevice::DisplayDevice(
         config = RenderEngine::chooseEglConfig(display, format);
 #endif
     }
+        /*
+     *  Sprd change here:
+     *  Enable EGL NV12 config for GPU output NV12 image, for
+     *  VirtualDisplay.
+     * */
+    getSPRDWindowSurfaceConfig(display, mType, &config);
     eglSurface = eglCreateWindowSurface(display, config, window, NULL);
+    format = getSPRDFBFormat(window, producer, mType);
     eglQuerySurface(display, eglSurface, EGL_WIDTH,  &mDisplayWidth);
     eglQuerySurface(display, eglSurface, EGL_HEIGHT, &mDisplayHeight);

--
# *** UNVERIFIED - NEEDS YOUR VENDOR TREE ***
# DisplayDevice's constructor gained several new parameters in Oreo
# (HdrCapabilities, active color mode, etc.), so the surrounding EGL-surface
# setup code has almost certainly moved to different line numbers, and
# possibly a different function scope, than in 14.1. I could not verify
# hardware/sprd/hwcomposer/SprdConfigChoose.h's 15.1-era signature for
# getSPRDWindowSurfaceConfig()/getSPRDFBFormat() without that vendor tree.
# Apply this hunk by hand against your actual DisplayDevice.cpp: find the
# eglCreateWindowSurface() call for the real display and insert the two
# Sprd calls immediately around it, same as before.

diff --git a/services/surfaceflinger/SurfaceFlinger.h b/services/surfaceflinger/SurfaceFlinger.h
index b0d327221..fec0cc87a 100644
--- a/services/surfaceflinger/SurfaceFlinger.h
+++ b/services/surfaceflinger/SurfaceFlinger.h
@@ -543,6 +543,8 @@ private:
     RenderEngine* mRenderEngine;
     nsecs_t mBootTime;
     bool mGpuToCpuSupported;
+    bool mDropMissedFrames;
+    bool mDaltonize;
     sp<EventThread> mEventThread;
     sp<EventThread> mSFEventThread;
     sp<EventControlThread> mEventControlThread;
--
# NOTE: mDaltonize is added here because in 8.1.0_r9 mHasColorMatrix already
# exists as a member (confirmed in the SurfaceFlinger() constructor
# initializer list: "mHasColorMatrix(false),"), but there is no
# corresponding mDaltonize flag yet at this point in the branch - it's
# needed by the setUpHWComposer()/doDisplayComposition() gating below.
# mDropMissedFrames is new, same purpose as the original patch.

diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index d71baf9f2..6ac28e890 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -162,6 +162,7 @@ SurfaceFlinger::SurfaceFlinger()
         mPrimaryDispSync("PrimaryDispSync"),
         mPrimaryHWVsyncEnabled(false),
         mHWVsyncAvailable(false),
+        mDaltonize(false),
         mHasColorMatrix(false),
         mHasPoweredOff(false),
         mFrameBuckets(),
@@ -177,6 +178,9 @@ SurfaceFlinger::SurfaceFlinger()
     property_get("ro.bq.gpu_to_cpu_unsupported", value, "0");
     mGpuToCpuSupported = !atoi(value);

+    property_get("debug.sf.drop_missed_frames", value, "0");
+    mDropMissedFrames = atoi(value);
+
     property_get("debug.sf.showupdates", value, "0");
     mDebugRegion = atoi(value);

--
# NOTE: this constructor block is confirmed byte-for-byte present in
# 8.1.0_r9 up to and including the "ro.bq.gpu_to_cpu_unsupported" property
# read and the "debug.sf.showupdates" read immediately after it, so the
# insertion point above is correct as anchored.

@@ -1098,7 +1102,25 @@ bool SurfaceFlinger::handleMessageInvalidate() {
 void SurfaceFlinger::handleMessageRefresh() {
     ATRACE_CALL();

-    preComposition();
+    static nsecs_t previousExpectedPresent = 0;
+    nsecs_t expectedPresent = mPrimaryDispSync.computeNextRefresh(0);
+    static bool previousFrameMissed = false;
+    bool frameMissed = (expectedPresent == previousExpectedPresent);
+    if (frameMissed != previousFrameMissed) {
+        ATRACE_INT("FrameMissed", static_cast<int>(frameMissed));
+    }
+    previousFrameMissed = frameMissed;
+
+    if (CC_UNLIKELY(mDropMissedFrames && frameMissed)) {
+        // Latch buffers, but don't send anything to HWC, then signal
+        // another wakeup for the next vsync
+        preComposition();
+        repaintEverything();
+        previousExpectedPresent = mPrimaryDispSync.computeNextRefresh(0);
+        return;
+    }
+
+    preComposition();
     rebuildLayerStacks();
     setUpHWComposer();
     doDebugFlashRegions();
     doComposition();
     postComposition();
+
+    previousExpectedPresent = mPrimaryDispSync.computeNextRefresh(0);
 }
--
# *** UNVERIFIED PAST THIS POINT - anchor confirmed, body reconstructed ***
# I could not pull the actual 8.1.0_r9 body of handleMessageRefresh()
# through the web UI (the file is too large for the viewer to return past
# ~1/3 of the way through), so this hunk is reconstructed from the original
# 14.1 patch's logic rather than diffed against real 15.1 text. Two things
# I DO know for certain from 8.1.0_r9 and have folded in already:
#   1. There is no ENABLE_FENCE_TRACKING / mFenceTracker / refreshStartTime
#      machinery left to guard - FenceTracker.h and .cpp do not exist in
#      the 8.1 services/surfaceflinger directory, and postComposition() in
#      this branch takes no refreshStartTime argument (frame timing moved
#      to FrameTracker/FrameEvent). So postComposition() is called with no
#      argument here, and every #ifdef ENABLE_FENCE_TRACKING block from the
#      original patch is simply deleted rather than ported.
#   2. mHwc->getRetireFence(HWC_DISPLAY_PRIMARY) and the per-layer
#      releasePendingBuffer()/mLayersWithQueuedFrames.clear() loop that
#      followed handleMessageRefresh() in 14.1 have almost certainly been
#      refactored into postComposition() itself in the HWC2-only 8.1
#      codebase (this logic moved there during the Oreo HWC2 unification),
#      so it is NOT reproduced again here to avoid a double-free/double-
#      release bug. Confirm against your tree - if releasePendingBuffer()
#      is still called from handleMessageRefresh() in your actual checkout,
#      you'll need to re-add that loop here instead.
# Please diff this function against your real SurfaceFlinger.cpp before
# building - treat this hunk as a strong sketch, not a verified patch.

@@ -1366,7 +1414,8 @@ void SurfaceFlinger::setUpHWComposer() {
                     }

                     layer->setGeometry(displayDevice);
-                    if (mDebugDisableHWC || mDebugRegion) {
+                    if (mDebugDisableHWC || mDebugRegion || mDaltonize ||
+                            mHasColorMatrix) {
                         layer->forceClientComposition(hwcId);
                     }
                 }
--
# NOTE: mHasColorMatrix is confirmed to exist as a member in 8.1.0_r9's
# constructor; this gating idiom (force client composition while a color
# matrix/daltonizer is active) is unchanged AOSP behavior across N and O,
# so the shape of this hunk should be correct, but the surrounding line
# numbers will differ - locate the "forceClientComposition(hwcId)" call in
# setUpHWComposer() and add the mDaltonize/mHasColorMatrix conditions there.

@@ -2082,7 +2131,18 @@ void SurfaceFlinger::doDisplayComposition(const sp<const DisplayDevice>& hw,
         }
     }

-    if (!doComposeSurfaces(hw, dirtyRegion)) return;
+    if (CC_LIKELY(!mDaltonize && !mHasColorMatrix)) {
+        if (!doComposeSurfaces(hw, dirtyRegion)) return;
+    } else {
+        RenderEngine& engine(getRenderEngine());
+        mat4 colorMatrix = mColorMatrix;
+        if (mDaltonize) {
+            colorMatrix = colorMatrix * mDaltonizer();
+        }
+        mat4 oldMatrix = engine.setupColorTransform(colorMatrix);
+        doComposeSurfaces(hw, dirtyRegion);
+        engine.setupColorTransform(oldMatrix);
+    }

     // update the swap region and clear the dirty region
     hw->swapRegion.orSelf(dirtyRegion);
--
# NOTE: same idiom as above (RenderEngine::setupColorTransform +
# Daltonizer::operator() building a mat4) is stable AOSP N->O code; this
# should port as-is once re-anchored to the real line numbers around
# doComposeSurfaces() in your checkout.

@@ -3357,6 +XXXX,7 @@ status_t SurfaceFlinger::onTransact(
                 } else {
                     mDaltonizer.setMode(ColorBlindnessMode::Simulation);
                 }
+                mDaltonize = n > 0;
                 invalidateHwcGeometry();
                 repaintEverything();
                 return NO_ERROR;
@@ -3364,6 +XXXX,7 @@ status_t SurfaceFlinger::onTransact(
             case 1015: {
                 // apply a color matrix
                 n = data.readInt32();
+                mHasColorMatrix = n ? 1 : 0;
                 if (n) {
                     // color matrix is sent as mat3 matrix followed by vec3
                     // offset, then packed into a mat4 where the last row is
